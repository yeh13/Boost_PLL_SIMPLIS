* E:\DAC test\FIXED60_PHASE40K_INTEGRATION\ADC_ONLY_CALIBRATION\native_adc_template_source.sxsch
*#SIMETRIX
.print
+ ALL
.options
+ PSP_NPT=1001
+ POP_ITRMAX=20
+ POP_OUTPUT_CYCLES=5
+ SNAPSHOT_INTVL=0
+ MIN_AVG_TOPOLOGY_DUR=1a
+ AVG_TOPOLOGY_DUR_MEASUREMENT_WINDOW=128
.tran 2u 0


.PRINT V(4)
.GRAPH :4 axisType="auto" persistence=-1 curveLabel="U1-D0" analysis="tran|pop" order="c" xLog="auto" yLog="auto"  nowarn=true disabled=false PROBEREF=Probe1  
.PRINT V(3)
.GRAPH :3 axisType="auto" persistence=-1 curveLabel="CLK" analysis="tran|pop" order="a" xLog="auto" yLog="auto"  nowarn=true disabled=false PROBEREF=Probe10  
.PRINT V(5)
.GRAPH :5 axisType="auto" persistence=-1 curveLabel="U1-D1" analysis="tran|pop" order="d" xLog="auto" yLog="auto"  nowarn=true disabled=false PROBEREF=Probe2  
.PRINT V(7)
.GRAPH :7 axisType="auto" persistence=-1 curveLabel="U1-D2" analysis="tran|pop" order="e" xLog="auto" yLog="auto"  nowarn=true disabled=false PROBEREF=Probe3  
.PRINT V(8)
.GRAPH :8 axisType="auto" persistence=-1 curveLabel="U1-D3" analysis="tran|pop" order="f" xLog="auto" yLog="auto"  nowarn=true disabled=false PROBEREF=Probe4  
.PRINT V(11)
.GRAPH :11 axisType="auto" persistence=-1 curveLabel="U1-POFL" analysis="tran|pop" order="g" xLog="auto" yLog="auto"  nowarn=true disabled=false PROBEREF=Probe5  
.PRINT V(12)
.GRAPH :12 axisType="auto" persistence=-1 curveLabel="U1-NOFL" analysis="tran|pop" order="h" xLog="auto" yLog="auto"  nowarn=true disabled=false PROBEREF=Probe6  
.PRINT V(14)
.GRAPH :14 axisType="auto" persistence=-1 curveLabel="U1-DR" analysis="tran|pop" order="i" xLog="auto" yLog="auto"  nowarn=true disabled=false PROBEREF=Probe7  
.PRINT V(2)
.GRAPH :2 axisType="auto" persistence=-1 curveLabel="Input" analysis="tran|pop" xLog="auto" yLog="auto"  nowarn=true disabled=false PROBEREF=Probe8  
.PRINT V(6)
.GRAPH :6 axisType="auto" persistence=-1 curveLabel="U1-EN" analysis="tran|pop" order="b" xLog="auto" yLog="auto"  nowarn=true disabled=false PROBEREF=Probe9  
X$U1 4 5 7 8 9 10 11 12 14 15 16 17 18 19 20 2 3 6 21 SIMPLIS_DIGI1_D_A2D_CONVERTER_YX$U1 vars: RIN=10Meg ROUT=10 TH=2.5 HYSTWD=1 VOL=0 VOH=5 RANGE=2.2021505376344086 OFFSET=0 CODE='UNSIGNED' MIN_CLK=10p TRIG_COND='0_TO_1' SAMPLE_DELAY=1p ENABLE_DELAY=15p CONVERT_TIME=50p DATA_READY_DELAY=10p IC=0 IC_OFL=0 IC_DATA_READY=1
.SUBCKT SIMPLIS_DIGI1_D_A2D_CONVERTER_YX$U1 2001 2002 2003 2004 2005 2006 2007 2008 2009 2010 2011 2012 2013 2014 2015 1001 1002 1003 100 vars: RIN=10Meg ROUT=10 TH=2.5 HYSTWD=1 VOL=0 VOH=5 RANGE=2.5 OFFSET=1.25 CODE='UNSIGNED' MIN_CLK=10p TRIG_COND='0_TO_1' SAMPLE_DELAY=1p ENABLE_DELAY=15p CONVERT_TIME=50p DATA_READY_DELAY=10p IC=0 IC_OFL=0 IC_DATA_READY=1
.NODE_MAP D0 2001
.NODE_MAP D1 2002
.NODE_MAP D2 2003
.NODE_MAP D3 2004
.NODE_MAP D4 2005
.NODE_MAP D5 2006
.NODE_MAP D6 2007
.NODE_MAP D7 2008
.NODE_MAP D8 2009
.NODE_MAP D9 2010
.NODE_MAP D10 2011
.NODE_MAP D11 2012
.NODE_MAP POFL 2013
.NODE_MAP NOFL 2014
.NODE_MAP DR 2015
.NODE_MAP IN 1001
.NODE_MAP CLK 1002
.NODE_MAP EN 1003
.NODE_MAP RTN 100
A_D_A2D_CONVERTER %%gnd_ref 100 [ 2001 2002 2003 2004 2005 2006 2007 2008 2009 2010 2011 2012 2013 2014 2015 ] [ 1001 1002 1003 ] MODEL=MD_A2D_CONVERTERM IC={IC} IC_OFL={IC_OFL} IC_DATA_READY={IC_DATA_READY}
.MODEL MD_A2D_CONVERTERM DIGITAL1 D_A2D_CONVERTER
+ RIN={RIN}
+ ROUT={ROUT}
+ TH={TH}
+ HYSTWD={HYSTWD}
+ VOL={VOL}
+ VOH={VOH}
+ RANGE={RANGE}
+ OFFSET={OFFSET}
+ CODE={CODE}
+ MIN_CLK={MIN_CLK}
+ TRIG_COND={TRIG_COND}
+ SAMPLE_DELAY={SAMPLE_DELAY}
+ ENABLE_DELAY={ENABLE_DELAY}
+ CONVERT_TIME={CONVERT_TIME}
+ DATA_READY_DELAY={DATA_READY_DELAY}
.ENDS SIMPLIS_DIGI1_D_A2D_CONVERTER_YX$U1

X$U2 3 SIMPLIS_DIGI1_D_PULSE_N_N vars: PERIOD=25u WIDTH=12.5u DELAY=50n ROUT=10 VOL=0 VOH=5 COMP='N' GNDREF='N'
X$U3 13 6 SIMPLIS_DIGI1_D_PULSE_Y_N vars: PERIOD=0 WIDTH=500n DELAY=1u ROUT=10 VOL=0 VOH=5 COMP='Y' GNDREF='N'
X$V1 2 0 SIN_SOURCE vars: _V1=-1 _V2=-1 _FREQ=285.71429k _DELAY=0 _DRATIOx100=50 _T_RISE=0 _T_FALL=0 _DAMP_COEF=0 _PWIDTH=0 _OFF_UNTIL_DELAY=0 _IDLE_IN_POP=0 _USEPHASE=0 _PHASE=0 _SHOWPARAMS=0
.end
